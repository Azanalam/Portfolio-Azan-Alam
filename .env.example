# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Admin CMS credentials. REQUIRED in production: the server refuses to start
# without them (NODE_ENV=production). In development these default to the
# values in server.ts.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-me-to-a-long-random-password"
JWT_SECRET="change-me-to-a-long-random-secret"

# Supabase database credentials. The service-role key must NEVER be exposed to
# the client (it bypasses Row Level Security). When these are unset the server
# falls back to local database.json storage only.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"
# Contact form email delivery via Resend (https://resend.com).
# Optional: when RESEND_API_KEY is unset the /api/contact endpoint still
# validates, rate-limits, and saves submissions to data/inquiries.json
# (gitignored) but skips sending email.
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"
# Sender must be a verified domain in Resend, or leave default (onboarding@resend.dev).
# RESEND_FROM_EMAIL="Azan Alam <hello@your-domain.com>"
# Delivery destination override; defaults to the portfolio settings email.
# CONTACT_TO_EMAIL="azanalam7@gmail.com"
